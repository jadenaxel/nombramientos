# El bootstrap local genera valores aleatorios y los guarda con ACL restringida en
# packages/database/.local/install.json. No copie credenciales reales a este archivo.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000
# Desarrollo local: omitido significa que X-Forwarded-For nunca se confia.
# Produccion exige una lista explicita de IP/CIDR de los proxies inmediatos;
# use el rango mas estrecho posible. Los comodines /0 son rechazados.
# API_TRUSTED_PROXY_CIDRS=127.0.0.1/32
API_COOKIE_SECURE=false
API_SESSION_TTL_SECONDS=28800
DATABASE_POOL_MAX_PER_TENANT=3
DATABASE_POOL_IDLE_MS=60000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Solo para instalaciones administradas fuera del bootstrap local:
# DATABASE_CONTROL_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/nombramientos_control
# DATABASE_SECRET_MASTER_KEY_B64=<32-bytes-base64url>
# AUTH_ENCRYPTION_KEY_B64=<32-bytes-base64url>
# DATABASE_SECRET_FILE=<absolute-path-to-encrypted-secret-store>
