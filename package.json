{
  "name": "nombramientos-adventistas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @nombramientos/domain test && pnpm --filter @nombramientos/e2ee test && pnpm --filter @nombramientos/database test && pnpm --filter @nombramientos/api test && pnpm --filter @nombramientos/web test:unit && pnpm test:verification",
    "test:verification": "node --test ./scripts/verify-local-evidence.test.mjs ./scripts/publish-performance-sentinel.test.mjs ./scripts/scan-secrets.test.mjs",
    "lint": "pnpm --filter @nombramientos/web lint",
    "bootstrap:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bootstrap-local.ps1",
    "start:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-local.ps1",
    "stop:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-local.ps1",
    "verify:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/verify-local.ps1",
    "container:secrets:dev": "node ./scripts/container-secrets.mjs init development",
    "container:secrets:test": "node ./scripts/container-secrets.mjs init test",
    "container:secrets:check:dev": "node ./scripts/container-secrets.mjs check development",
    "container:secrets:check:test": "node ./scripts/container-secrets.mjs check test",
    "container:config": "docker compose --env-file ./config/container/development.compose.env config --quiet",
    "container:up": "docker compose --env-file ./config/container/development.compose.env up --build --detach --wait",
    "container:down": "docker compose --env-file ./config/container/development.compose.env down",
    "container:test:config": "docker compose --env-file ./config/container/test.compose.env config --quiet",
    "container:test:up": "docker compose --env-file ./config/container/test.compose.env up --build --detach --wait",
    "container:test:down": "docker compose --env-file ./config/container/test.compose.env down",
    "db:bootstrap": "pnpm --filter @nombramientos/database db:bootstrap",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./packages/database/scripts/local-cluster.ps1 -Action start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./packages/database/scripts/local-cluster.ps1 -Action stop",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./packages/database/scripts/local-cluster.ps1 -Action status",
    "db:verify:local-state": "pnpm --silent --filter @nombramientos/database db:verify:local-state",
    "db:migrate": "pnpm --filter @nombramientos/database db:migrate:control",
    "db:grants:tenant": "pnpm --filter @nombramientos/database db:grants:tenant",
    "db:provision": "pnpm --filter @nombramientos/database db:provision",
    "db:sync:gestionchurch": "pnpm --filter @nombramientos/database db:sync:gestionchurch",
    "db:seed:demo": "pnpm --filter @nombramientos/database db:seed:demo",
    "db:bootstrap:platform-admin": "pnpm --filter @nombramientos/database db:bootstrap:platform-admin",
    "dev:api": "pnpm --filter @nombramientos/api dev",
    "dev:web": "pnpm --filter @nombramientos/web dev",
    "test:e2e": "pnpm --filter @nombramientos/web test:e2e",
    "test:e2e:real-stack:check": "pnpm --filter @nombramientos/api e2e:real-stack:check",
    "test:e2e:real-stack:local": "pnpm --filter @nombramientos/api e2e:real-stack:local",
    "performance:local": "pnpm --filter @nombramientos/api performance:local",
    "performance:scale:local": "pnpm --filter @nombramientos/api performance:scale:local",
    "performance:browser:local": "pnpm --filter @nombramientos/web performance:browser:local",
    "security:secrets": "node ./scripts/scan-secrets.mjs --self-test && node ./scripts/scan-secrets.mjs --scope source",
    "security:delivery": "node ./scripts/scan-secrets.mjs --self-test && node ./scripts/scan-secrets.mjs --scope delivery --report ./artifacts/delivery-security-scan.json",
    "security:sbom": "node ./scripts/generate-sbom.mjs",
    "security:supply-chain": "pnpm security:secrets && pnpm security:sbom"
  }
}
